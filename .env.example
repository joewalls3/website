# Added automatically when Clerk is installed from the Vercel Marketplace.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk routes and post-auth redirects.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Set this after the first successful sign-in to keep the dashboard owner-only.
OWNER_CLERK_USER_ID=

# Server-only OpenAI credentials for the owner dashboard agent.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
